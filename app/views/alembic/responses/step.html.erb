<% content_for(:title, @guide.headline) %>

<%= ui_page(max_width: :md) do %>
  <%= link_to "← Start over", alembic.diagnostic_path(@guide.slug), class: "text-sm text-accent-600 hover:text-accent-700" %>

  <div class="mt-6 mb-6">
    <%= ui_progress(value: @response.recorded.size, max: [ @response.recorded.size + 1, 1 ].max, label: "Question #{@response.recorded.size + 1}") %>
  </div>

  <%= form_with url: alembic.response_path(@response), method: :patch, data: { turbo: false } do %>
    <fieldset>
      <legend class="mb-5 text-xl font-semibold leading-snug text-gray-900"><%= @question.text %></legend>

      <div class="space-y-3">
        <% @question.choices.each do |choice| %>
          <%= ui_radio_card(name: "answers[#{@question.id}]", value: choice.value, label: choice.label.presence || choice.value, hint: choice.hint) %>
        <% end %>
      </div>
    </fieldset>

    <div class="mt-8 flex items-center gap-4">
      <%= ui_button(label: "Next", type: :submit) %>

      <% if @response.recorded.any? %>
        <button type="submit" name="back" value="1" formnovalidate class="cursor-pointer text-sm text-gray-500 underline underline-offset-2 hover:text-gray-900">← Back</button>
      <% end %>
    </div>
  <% end %>
<% end %>
