<% content_for(:title, "Complete") %>

<%= ui_page(max_width: :md) do %>
  <%= ui_page_header(title: "That's everything", subtitle: "Thanks — here's what you told us") do |header| %>
    <% header.action do %>
      <%= ui_button(label: "Start over", href: alembic.diagnostic_path(@guide.slug), variant: :secondary) %>
    <% end %>
  <% end %>

  <% if @outputs.any? %>
    <%= ui_section do %>
      <%= ui_grid(cols: { default: 1, sm: 2 }, gap: :lg) do %>
        <% @outputs.each do |output| %>
          <div data-output="<%= output.id %>" class="rounded-lg border border-gray-200 px-5 py-4 dark:border-zinc-700">
            <p class="text-xs font-semibold uppercase tracking-widest text-accent-600"><%= output.label %></p>
            <% lines = alembic_output_lines(output.value) %>
            <% if lines.one? %>
              <p class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= lines.first %></p>
            <% else %>
              <ul class="mt-1 space-y-0.5">
                <% lines.each do |line| %>
                  <li class="font-medium text-gray-900 dark:text-white"><%= line %></li>
                <% end %>
              </ul>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= ui_section(title: @outputs.any? ? "What you told us" : nil) do %>
    <ul class="divide-y divide-gray-100 border-y border-gray-100">
      <% @answered.each do |step, value| %>
        <li data-answer="<%= step %>" class="flex items-baseline justify-between gap-6 py-3">
          <span class="text-gray-600"><%= @guide.question_text(step) %></span>
          <span class="shrink-0 font-medium text-gray-900"><%= @guide.choice_label(step, value) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
