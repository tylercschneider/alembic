<% tier = @guide.tier(@placement.tier) %>
<% level = @guide.level(@placement.level) %>
<% summary = "Tier #{@placement.tier} (#{tier.name})#{level ? ", #{level.name}" : ""}#{@placement.grade ? ", #{@placement.grade}-grade" : ""}." %>
<% content_for(:title, "Your placement — #{@guide.headline}") %>

<section class="py-20 md:py-28">
  <div class="max-w-2xl mx-auto px-6">
    <%= link_to "← Start over", diagnostic_path(@guide.slug), class: "text-sm text-accent-600 hover:text-accent-700" %>

    <div class="mt-6 mb-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent-600 mb-3">Your placement</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 mb-2"><%= tier.name %></h1>
      <p class="text-lg text-gray-600 mb-5"><%= tier.tagline %></p>

      <div class="flex flex-wrap gap-2">
        <%= ui_badge(label: "Tier #{@placement.tier}", variant: :info) %>
        <% if level %>
          <%= ui_badge(label: level.name, variant: :neutral) %>
        <% end %>
        <% if @placement.grade %>
          <%= ui_badge(label: "#{@placement.grade}-grade", variant: @placement.grade == :money ? :danger : :neutral) %>
        <% end %>
      </div>
    </div>

    <% if @placement.warning %>
      <div class="mb-10">
        <%= ui_alert(message: @guide.warning_text(@placement.warning), type: @placement.warning_ok ? :success : :warning) %>
      </div>
    <% end %>

    <div class="mb-10 flex flex-wrap gap-3">
      <%= ui_button(label: "See how to build #{tier.name} →", href: diagnostic_path(@guide.slug, anchor: "tier-#{@placement.tier}")) %>
      <%= ui_button(label: "Explore the whole ladder", href: diagnostic_path(@guide.slug, anchor: "ladder"), variant: :secondary) %>
    </div>

    <% if Alembic.lead_partial %>
      <%= render Alembic.lead_partial, guide: @guide, placement: @placement, summary: summary %>
    <% end %>
  </div>
</section>
