<% content_for(:title, "Your result — #{@guide.headline}") %>

<section class="py-20 md:py-28">
  <div class="max-w-2xl mx-auto px-6">
    <%= link_to "← Start over", alembic.diagnostic_path(@guide.slug), class: "text-sm text-accent-600 hover:text-accent-700" %>

    <div class="mt-6 mb-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent-600 mb-3">Your result</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 mb-2"><%= @band.name %></h1>
      <p class="text-lg text-gray-600 mb-5"><%= @band.description %></p>

      <% if @overall_percentage %>
        <%= ui_badge(label: "Overall: #{@overall_percentage}%", variant: :info) %>
      <% else %>
        <%= ui_badge(label: "Score: #{@score}", variant: :info) %>
      <% end %>
    </div>

    <% if @domain_percentages %>
      <ul class="mb-8 divide-y divide-gray-100 border-y border-gray-100">
        <% @domain_percentages.each do |domain, percentage| %>
          <li class="flex items-baseline justify-between py-3"><span class="text-gray-900"><%= domain.name %></span><span class="text-sm font-semibold text-gray-500"><%= percentage %>%</span></li>
        <% end %>
      </ul>
    <% end %>

    <% if @blind_spots %>
      <h2 class="text-xs font-semibold uppercase tracking-widest text-accent-600 mb-3">Your blind spots</h2>
      <% @blind_spots.each do |domain| %>
        <div class="mb-5">
          <h3 class="font-semibold text-gray-900"><%= domain.name %></h3>
          <p class="text-gray-600"><%= domain.gap_meaning %></p>
          <p class="text-sm text-gray-500"><%= domain.gap_cost %></p>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
