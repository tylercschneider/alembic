<% content_for(:title, "Your result — #{@guide.headline}") %>

<section class="py-20 md:py-28">
  <div class="max-w-2xl mx-auto px-6">
    <%= link_to "← Start over", diagnostic_path(@guide.slug), class: "text-sm text-accent-600 hover:text-accent-700" %>

    <div class="mt-6 mb-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent-600 mb-3">Your result</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 mb-2"><%= @band.name %></h1>
      <p class="text-lg text-gray-600 mb-5"><%= @band.description %></p>

      <%= ui_badge(label: "Score: #{@score}", variant: :info) %>
    </div>
  </div>
</section>
