<%= ui_panel(padding: :lg) do %>
  <details id="<%= anchor %>" class="group">
    <summary class="flex items-start gap-3 cursor-pointer list-none">
      <span class="text-xs font-semibold uppercase tracking-wider text-accent-600 border border-accent-200 rounded px-2 py-1 shrink-0"><%= eyebrow %></span>
      <span class="flex-1">
        <span class="block text-lg font-semibold text-gray-900"><%= node.name %></span>
        <span class="block text-sm text-gray-500"><%= node.tagline %></span>
      </span>
      <span class="text-gray-400 transition group-open:rotate-90">&#9656;</span>
    </summary>

    <div class="mt-5 space-y-5">
      <dl class="grid grid-cols-1 sm:grid-cols-3 gap-px overflow-hidden rounded-lg bg-gray-200">
        <div class="bg-gray-50 p-3"><dt class="text-xs uppercase tracking-wide text-gray-400 mb-1">Complexity</dt><dd class="text-sm text-gray-900"><%= node.complexity %></dd></div>
        <div class="bg-gray-50 p-3"><dt class="text-xs uppercase tracking-wide text-gray-400 mb-1">Setup</dt><dd class="text-sm text-gray-900"><%= node.setup %></dd></div>
        <div class="bg-gray-50 p-3"><dt class="text-xs uppercase tracking-wide text-gray-400 mb-1">Maintenance</dt><dd class="text-sm text-gray-900"><%= node.maintenance %></dd></div>
      </dl>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-accent-600 mb-1">What it captures</h4>
        <p class="text-gray-700"><%= node.captures %></p>
      </div>
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-accent-600 mb-1">Why it works</h4>
        <p class="text-gray-700"><%= node.why %></p>
      </div>
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-accent-600 mb-1">The pains / hard limits</h4>
        <p class="text-gray-700"><%= node.pains %></p>
      </div>
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-red-600 mb-1">What people do to avoid it</h4>
        <p class="text-gray-700"><%= node.avoid %></p>
        <p class="mt-1 text-sm text-red-700"><span class="font-semibold">Result:</span> <%= node.avoid_pain %></p>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-accent-600 mb-2">How to build it</h4>
        <% node.build_steps.each_with_index do |step, index| %>
          <p class="text-sm font-semibold text-gray-900 mt-3"><%= index + 1 %>. <%= step.title %></p>
          <pre class="mt-1 overflow-x-auto rounded-lg bg-gray-900 p-4 text-xs leading-relaxed text-gray-100"><code><%= step.code %></code></pre>
        <% end %>
      </div>
    </div>
  </details>
<% end %>
