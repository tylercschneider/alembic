<%= ui_page(max_width: :lg) do %>
  <%= ui_form_page(title: "Edit question", back_url: alembic.manage_diagnostic_questions_path(@diagnostic), subtitle: @question.key) %>

  <%= ui_form(action: alembic.manage_diagnostic_question_path(@diagnostic, @question), method: :patch) do %>
    <label class="block text-sm font-medium mb-1">Question text</label>
    <%= ui_input(name: "question[text]", value: @question.text) %>

    <%= ui_section(title: "Options") do %>
      <% @question.options.ordered.each_with_index do |option, index| %>
        <div class="mb-4">
          <%= hidden_field_tag "question[options_attributes][#{index}][id]", option.id %>
          <%= ui_input(name: "question[options_attributes][#{index}][value]", value: option.value, placeholder: "value") %>
          <%= ui_input(name: "question[options_attributes][#{index}][label]", value: option.label, placeholder: "label") %>
          <%= ui_input(name: "question[options_attributes][#{index}][hint]", value: option.hint, placeholder: "hint") %>
          <label class="inline-flex items-center gap-2 mt-1 text-sm text-gray-500">
            <%= check_box_tag "question[options_attributes][#{index}][_destroy]", "1", false %> Remove
          </label>
        </div>
      <% end %>
    <% end %>

    <%= ui_button(label: "Save", type: :submit) %>
  <% end %>

  <%= ui_form(action: alembic.manage_diagnostic_question_options_path(@diagnostic, @question), method: :post) do %>
    <%= ui_button(label: "Add option", type: :submit, variant: :secondary) %>
  <% end %>

  <%= ui_form(action: alembic.manage_diagnostic_question_condition_path(@diagnostic, @question), method: :patch) do %>
    <%= ui_section(title: "Condition", subtitle: "Show this question only when another question is answered with one of the checked options") do %>
      <% condition_options = @question.conditions.first&.options.to_a %>
      <% @diagnostic.questions.ordered.where.not(id: @question.id).each do |other| %>
        <p class="font-medium text-gray-900 dark:text-white mt-3"><%= other.text.presence || other.key %></p>
        <% other.options.ordered.each do |option| %>
          <label class="inline-flex items-center gap-2 mr-4 text-sm text-gray-600 dark:text-gray-300">
            <%= check_box_tag "condition[option_ids][]", option.id, condition_options.include?(option) %>
            <%= option.label.presence || option.value %>
          </label>
        <% end %>
      <% end %>
    <% end %>

    <%= ui_button(label: "Save condition", type: :submit) %>
  <% end %>
<% end %>
