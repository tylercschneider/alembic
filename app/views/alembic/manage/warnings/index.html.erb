<%= ui_page(max_width: :xl) do %>
  <%= ui_page_header(title: "Warnings", subtitle: @diagnostic.title.presence || @diagnostic.slug) do |header| %>
    <% header.action do %>
      <%= ui_button(label: "Back to diagnostic", href: alembic.manage_diagnostic_path(@diagnostic), variant: :secondary) %>
    <% end %>
  <% end %>

  <% if @warnings.any? %>
    <ul class="mt-6 divide-y divide-gray-200 dark:divide-zinc-700">
      <% @warnings.each do |warning| %>
        <li class="py-4 flex items-center justify-between">
          <div>
            <p class="font-medium text-gray-900 dark:text-white"><%= warning.key %></p>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= warning.text %></p>
          </div>
          <div class="flex items-center gap-4">
            <%= link_to "Edit", alembic.edit_manage_diagnostic_warning_path(@diagnostic, warning), class: "text-sm text-accent-700 dark:text-accent-300" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-6 text-gray-500 dark:text-gray-400">No warnings yet.</p>
  <% end %>

  <%= ui_section(title: "Add a warning") do %>
    <%= ui_form(action: alembic.manage_diagnostic_warnings_path(@diagnostic), method: :post) do %>
      <label class="block text-sm font-medium mb-1">Key</label>
      <%= ui_input(name: "warning[key]", placeholder: "e.g. money_pairing") %>

      <%= ui_button(label: "Add warning", type: :submit, variant: :secondary) %>
    <% end %>
  <% end %>
<% end %>
