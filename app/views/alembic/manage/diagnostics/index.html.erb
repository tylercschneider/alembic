<%= ui_page(max_width: :xl) do %>
  <%= ui_page_header(title: "Diagnostics", subtitle: "Build and edit your diagnostics") %>

  <%= ui_data_table(
    items: @diagnostics,
    columns: [ { title: "Title" }, { slug: "Slug" }, { kind: "Kind" }, { status: "Status" } ],
    empty_message: "No diagnostics yet."
  ) do |table| %>
    <% table.link(:title) { |diagnostic| alembic.manage_diagnostic_path(diagnostic) } %>
  <% end %>

  <%= ui_section(title: "Create a diagnostic") do %>
    <%= ui_form(action: alembic.manage_diagnostics_path, method: :post) do %>
      <label class="block text-sm font-medium mb-1">Slug</label>
      <%= ui_input(name: "diagnostic[slug]", placeholder: "e.g. business-scorecard") %>

      <label class="block text-sm font-medium mb-1 mt-4">Kind</label>
      <%= ui_select(name: "diagnostic[kind]", options: [ [ "Scored", "scored" ], [ "Guide", "guide" ] ]) %>

      <%= ui_button(label: "Create", type: :submit, variant: :secondary) %>
    <% end %>
  <% end %>
<% end %>
