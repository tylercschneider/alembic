<%= ui_page(max_width: :xl) do %>
  <%= ui_page_header(title: @diagnostic.title.presence || @diagnostic.slug, subtitle: @diagnostic.slug) do |header| %>
    <% header.action do %>
      <%= ui_button(label: "Edit details", href: alembic.edit_manage_diagnostic_path(@diagnostic)) %>
      <%= ui_form(action: alembic.compile_manage_diagnostic_path(@diagnostic), method: :post) do %>
        <%= ui_button(label: "Update", type: :submit) %>
      <% end %>
      <%= ui_form(action: alembic.revert_manage_diagnostic_path(@diagnostic), method: :post) do %>
        <%= ui_button(label: "Revert", type: :submit, variant: :secondary) %>
      <% end %>
      <%= ui_button(label: "All diagnostics", href: alembic.manage_diagnostics_path, variant: :secondary) %>
    <% end %>
  <% end %>

  <%= ui_section(title: "Modules", subtitle: "Click into a part to edit it") do %>
    <%= ui_grid(cols: { default: 1, sm: 2, lg: 4 }, gap: :lg) do %>
      <%= ui_card(title: "Questions", summary: "#{@diagnostic.questions.count} questions", link: alembic.manage_diagnostic_questions_path(@diagnostic), cta: "Edit questions") %>
      <%= ui_card(title: "Tiers", summary: "#{@diagnostic.nodes.where(kind: "tier").count} tiers", link: alembic.manage_diagnostic_nodes_path(@diagnostic), cta: "Edit tiers & levels") %>
      <%= ui_card(title: "Levels", summary: "#{@diagnostic.nodes.where(kind: "level").count} levels", link: alembic.manage_diagnostic_nodes_path(@diagnostic), cta: "Edit tiers & levels") %>
      <%= ui_card(title: "Warnings", summary: "#{@diagnostic.warnings.count} warnings", link: alembic.manage_diagnostic_warnings_path(@diagnostic), cta: "Edit warnings") %>
      <%= ui_card(title: "Bands", summary: "#{@diagnostic.bands.count} bands", link: alembic.manage_diagnostic_bands_path(@diagnostic), cta: "Edit bands") %>
    <% end %>
  <% end %>
<% end %>
