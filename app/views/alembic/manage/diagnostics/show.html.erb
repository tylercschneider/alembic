<%= ui_page(max_width: :xl) do %>
  <%= ui_page_header(title: @diagnostic.title.presence || @diagnostic.slug, subtitle: @diagnostic.slug) do |header| %>
    <% header.action do %>
      <%= ui_button(label: "Edit details", href: alembic.edit_manage_diagnostic_path(@diagnostic)) %>
      <%= ui_button(label: "All diagnostics", href: alembic.manage_diagnostics_path, variant: :secondary) %>
    <% end %>
  <% end %>

  <%= ui_section(title: "Flow", subtitle: "The definition is what visitors walk") do %>
    <%= ui_grid(cols: { default: 1, sm: 2 }, gap: :lg) do %>
      <%= ui_card(title: "Flow", summary: "#{@steps.size} steps on the canvas", link: alembic.manage_diagnostic_canvas_path(@diagnostic), cta: "Open the canvas") %>
      <%= ui_card(title: "Steps", summary: "#{@steps.size} steps", link: alembic.manage_diagnostic_steps_path(@diagnostic), cta: "Order the flow") %>
      <%= ui_card(title: "Definition", summary: "Version #{@diagnostic.current_definition_version&.number || 0}", link: alembic.edit_manage_diagnostic_definition_path(@diagnostic), cta: "Edit the document") %>
    <% end %>
  <% end %>
<% end %>
