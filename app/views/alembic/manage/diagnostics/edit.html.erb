<%= ui_page(max_width: :lg) do %>
  <%= ui_form_page(title: "Edit details", back_url: alembic.manage_diagnostic_path(@diagnostic)) %>

  <%= ui_form(action: alembic.manage_diagnostic_path(@diagnostic), method: :patch) do %>
    <%= ui_section(title: "How this is introduced") do %>
      <label class="block text-sm font-medium mb-1">Title</label>
      <%= ui_input(name: "diagnostic[title]", value: @diagnostic.title) %>

      <label class="block text-sm font-medium mb-1 mt-4">Summary</label>
      <%= ui_textarea(name: "diagnostic[summary]", value: @diagnostic.summary, rows: 4) %>

      <label class="block text-sm font-medium mb-1 mt-4">Start label</label>
      <%= ui_input(name: "diagnostic[start_label]", value: @diagnostic.start_label) %>
    <% end %>

    <%= ui_button(label: "Save", type: :submit) %>
  <% end %>
<% end %>
