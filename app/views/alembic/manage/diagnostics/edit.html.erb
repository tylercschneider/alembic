<%= ui_page(max_width: :lg) do %>
  <%= ui_form_page(title: "Edit details", back_url: manage_diagnostic_path(@diagnostic)) %>

  <%= ui_form(action: manage_diagnostic_path(@diagnostic), method: :patch) do %>
    <%= ui_section(title: "Copy") do %>
      <label class="block text-sm font-medium mb-1">Kicker</label>
      <%= ui_input(name: "diagnostic[kicker]", value: @diagnostic.kicker) %>

      <label class="block text-sm font-medium mb-1 mt-4">Headline</label>
      <%= ui_input(name: "diagnostic[headline]", value: @diagnostic.headline) %>

      <label class="block text-sm font-medium mb-1 mt-4">Blurb</label>
      <%= ui_textarea(name: "diagnostic[blurb]", value: @diagnostic.blurb, rows: 4) %>

      <label class="block text-sm font-medium mb-1 mt-4">Start label</label>
      <%= ui_input(name: "diagnostic[start_label]", value: @diagnostic.start_label) %>
    <% end %>

    <%= ui_section(title: "Placement") do %>
      <label class="block text-sm font-medium mb-1">Resolver key</label>
      <%= ui_input(name: "diagnostic[resolver_key]", value: @diagnostic.resolver_key) %>
    <% end %>

    <%= ui_button(label: "Save", type: :submit) %>
  <% end %>
<% end %>
