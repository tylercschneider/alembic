<%= ui_page(max_width: :lg) do %>
  <%= ui_form_page(title: "Edit #{@band.name}", back_url: alembic.manage_diagnostic_bands_path(@diagnostic)) %>

  <%= ui_form(action: alembic.manage_diagnostic_band_path(@diagnostic, @band), method: :patch) do %>
    <label class="block text-sm font-medium mb-1">Name</label>
    <%= ui_input(name: "band[name]", value: @band.name) %>

    <label class="block text-sm font-medium mb-1 mt-4">Ceiling</label>
    <%= ui_input(name: "band[ceiling]", value: @band.ceiling) %>

    <label class="block text-sm font-medium mb-1 mt-4">Description</label>
    <%= ui_textarea(name: "band[description]", value: @band.description, rows: 3) %>

    <%= ui_button(label: "Save", type: :submit) %>
  <% end %>
<% end %>
