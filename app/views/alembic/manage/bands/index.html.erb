<%= ui_page(max_width: :xl) do %>
  <%= ui_page_header(title: "Bands", subtitle: @diagnostic.title.presence || @diagnostic.slug) do |header| %>
    <% header.action do %>
      <%= ui_button(label: "Back to diagnostic", href: alembic.manage_diagnostic_path(@diagnostic), variant: :secondary) %>
    <% end %>
  <% end %>

  <% if @bands.any? %>
    <ul class="mt-6 divide-y divide-gray-200 dark:divide-zinc-700">
      <% @bands.each do |band| %>
        <li class="py-4 flex items-center justify-between">
          <div>
            <p class="font-medium text-gray-900 dark:text-white"><%= band.name %></p>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= band.description %></p>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-6 text-gray-500 dark:text-gray-400">No bands yet.</p>
  <% end %>
<% end %>
