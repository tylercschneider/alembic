<%= ui_page(max_width: :lg) do %>
  <%= ui_form_page(title: "Edit #{@node.kind} #{@node.key}", back_url: alembic.manage_diagnostic_nodes_path(@diagnostic), subtitle: @node.name) %>

  <%= ui_form(action: alembic.manage_diagnostic_node_path(@diagnostic, @node), method: :patch) do %>
    <label class="block text-sm font-medium mb-1">Name</label>
    <%= ui_input(name: "node[name]", value: @node.name) %>

    <% Alembic::Manage::NodesController::TEXT_FIELDS.each do |field| %>
      <label class="block text-sm font-medium mb-1 mt-4"><%= field.to_s.humanize %></label>
      <%= ui_textarea(name: "node[#{field}]", value: @node.public_send(field), rows: 2) %>
    <% end %>

    <%= ui_section(title: "Build steps") do %>
      <% @node.build_steps.order(:position).each_with_index do |step, index| %>
        <div class="mb-4">
          <%= hidden_field_tag "node[build_steps_attributes][#{index}][id]", step.id %>
          <%= ui_input(name: "node[build_steps_attributes][#{index}][title]", value: step.title, placeholder: "title") %>
          <%= ui_textarea(name: "node[build_steps_attributes][#{index}][code]", value: step.code, rows: 3) %>
          <label class="inline-flex items-center gap-2 mt-1 text-sm text-gray-500">
            <%= check_box_tag "node[build_steps_attributes][#{index}][_destroy]", "1", false %> Remove
          </label>
        </div>
      <% end %>
    <% end %>

    <%= ui_button(label: "Save", type: :submit) %>
  <% end %>

  <%= ui_section(title: "Build step order") do %>
    <% @node.build_steps.ordered.each do |step| %>
      <div class="py-2 flex items-center justify-between">
        <p class="text-sm text-gray-900 dark:text-white"><%= step.title %></p>
        <%= ui_form(action: alembic.move_down_manage_diagnostic_node_build_step_path(@diagnostic, @node, step), method: :post) do %>
          <%= ui_button(label: "Down", type: :submit, variant: :secondary) %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= ui_form(action: alembic.manage_diagnostic_node_build_steps_path(@diagnostic, @node), method: :post) do %>
    <%= ui_button(label: "Add build step", type: :submit, variant: :secondary) %>
  <% end %>
<% end %>
