<%= ui_page(max_width: :xl) do %>
  <%= ui_page_header(title: "Tiers & levels", subtitle: @diagnostic.title.presence || @diagnostic.slug) do |header| %>
    <% header.action do %>
      <%= ui_button(label: "Back to diagnostic", href: alembic.manage_diagnostic_path(@diagnostic), variant: :secondary) %>
    <% end %>
  <% end %>

  <% if @nodes.any? %>
    <ul class="mt-6 divide-y divide-gray-200 dark:divide-zinc-700">
      <% @nodes.each do |node| %>
        <li class="py-4 flex items-center justify-between">
          <div>
            <p class="font-medium text-gray-900 dark:text-white"><%= node.name %></p>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= node.kind %> · <%= node.key %> · <%= node.build_steps.count %> build steps</p>
          </div>
          <div class="flex items-center gap-4">
            <%= ui_form(action: alembic.move_down_manage_diagnostic_node_path(@diagnostic, node), method: :post) do %>
              <%= ui_button(label: "Down", type: :submit, variant: :secondary) %>
            <% end %>
            <%= link_to "Edit", alembic.edit_manage_diagnostic_node_path(@diagnostic, node), class: "text-sm text-accent-700 dark:text-accent-300" %>
            <%= ui_form(action: alembic.manage_diagnostic_node_path(@diagnostic, node), method: :delete) do %>
              <%= ui_button(label: "Remove", type: :submit, variant: :secondary) %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-6 text-gray-500 dark:text-gray-400">No tiers or levels yet.</p>
  <% end %>

  <%= ui_section(title: "Add a node") do %>
    <%= ui_form(action: alembic.manage_diagnostic_nodes_path(@diagnostic), method: :post) do %>
      <label class="block text-sm font-medium mb-1">Kind</label>
      <%= ui_select(name: "node[kind]", options: [ [ "Tier", "tier" ], [ "Level", "level" ] ]) %>

      <label class="block text-sm font-medium mb-1 mt-4">Key</label>
      <%= ui_input(name: "node[key]", placeholder: "e.g. 2 or l3") %>

      <%= ui_button(label: "Add node", type: :submit, variant: :secondary) %>
    <% end %>
  <% end %>
<% end %>
